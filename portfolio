<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sam - Portfolio</title>
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.6;
            background-color: #f4f4f4;
            color: #333;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: auto;
            overflow: hidden;
        }

        .navbar {
            background: #ffffff;
            color: #333;
            padding: 1rem 0;
            border-bottom: 1px solid #ddd;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        .navbar .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar .logo {
            font-size: 1.7rem;
            font-weight: bold;
            color: #333;
            text-decoration: none;
        }

        .navbar ul {
            display: flex;
            list-style: none;
        }

        .navbar ul li {
            margin-left: 25px;
        }

        .navbar ul li a {
            color: #555;
            text-decoration: none;
            font-size: 1.1rem;
            font-weight: 500;
        }
        
        .navbar ul li a:hover {
            color: #007BFF;
        }

        .hero {
            background: #333;
            color: #fff;
            padding: 4rem 0;
            text-align: center;
        }

        .hero h1 {
            font-size: 3rem;
            margin-bottom: 0.5rem;
        }

        .hero p {
            font-size: 1.2rem;
            margin-bottom: 1.5rem;
            color: #ccc;
        }

        .cta-button {
            display: inline-block;
            background: #007BFF;
            color: #fff;
            padding: 0.8rem 1.5rem;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            transition: background-color 0.3s ease;
        }

        .cta-button:hover {
            background: #0056b3;
        }

        .section {
            padding: 3rem 0;
        }
        
        .section-bg-grey {
             background-color: #fff;
             border-top: 1px solid #eee;
             border-bottom: 1px solid #eee;
        }

        .section-title {
            font-size: 2.2rem;
            text-align: center;
            margin-bottom: 2.5rem;
            color: #333;
        }
        
        #about .container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 3rem;
            flex-wrap: wrap;
        }
        
        .about-image {
            flex-basis: 250px;
            text-align: center;
        }
        
        .about-image img {
            width: 250px;
            height: 250px;
            border-radius: 50%;
            border: 5px solid #fff;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            object-fit: cover;
        }
        
        .about-text {
            flex-basis: 500px;
        }
        
        .about-text h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .about-text p {
            font-size: 1.1rem;
            text-align: left;
        }

        .projects-grid {
            display: flex;
            flex-wrap: wrap; 
            justify-content: center;
            gap: 1.5rem; 
        }

        .project-card {
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 8px;
            width: 320px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .project-card:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        }

        .project-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }
        
        .project-card-content {
             padding: 1.2rem;
        }
        
        .project-card-content h3 {
            font-size: 1.3rem;
            margin-bottom: 0.5rem;
        }

        .project-card-content p {
            font-size: 0.95rem;
        }

        #contact {
            text-align: center;
        }
        
        #contact p {
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto 1.5rem auto;
        }

        .footer {
            background: #333;
            color: #aaa;
            text-align: center;
            padding: 1.5rem 0;
            margin-top: 2rem;
        }
        
        .footer p {
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <header class="navbar">
        <div class="container">
            <a href="#" class="logo">Sameer</a>
            <ul>
                <li><a href="#about">About</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </div>
    </header>

    <section class="hero">
        <div class="container">
            <h1>Sameer Achara</h1>
            <p id="typewriter"></p>
            <a href="#contact" class="cta-button">Contact Me</a>
        </div>
    </section>

    <section id="about" class="section">
        <div class="container">
            
            <div class="about-image">
                <img src="Screenshot 2025-06-19 104144.png" alt="Profile Photo">
            </div>
            
            <div class="about-text">
                <h2 class="section-title" style="text-align: left; margin-bottom: 1.5rem;">About Me</h2>
                <h3>Hello! I'm Sameer.</h3>
                <p>
                    I’m an engineering student who enjoys building creative and simple web projects.  
                    I have a good understanding of HTML, CSS, and JavaScript, and I’m always learning new technologies.  
                    I’m passionate about coding, problem-solving, and creating user-friendly designs.
                </p>
            </div>
            
        </div>
    </section>

    <section id="projects" class="section section-bg-grey">
        <div class="container">
            <h2 class="section-title">My Projects</h2>
            
            <div class="projects-grid">
                
                <div class="project-card">
                    <img src="Screenshot 2025-10-28 132341.png" alt="Project 1">
                    <div class="project-card-content">
                        <h3>Smart Calculator</h3>
                        <p>
                            A Python-based command-line calculator that performs basic arithmetic, trigonometric, and conversion operations.
                        </p>
                    </div>
                </div>
                
                <div class="project-card">
                    <img src="Screenshot 2025-10-28 132448.png" alt="Project 2">
                    <div class="project-card-content">
                        <h3>Simple Product Website</h3>
                        <p>
                            A responsive HTML and CSS website designed to Sell The Products.
                        </p>
                    </div>
                </div>
                
                <div class="project-card">
                    <img src="2d-graphic-colorful-wallpaper-with-grainy-gradients.jpg" alt="Project 3">
                    <div class="project-card-content">
                        <h3>Portfolio Website</h3>
                        <p>
                            A personal portfolio website built using HTML, CSS, and JavaScript to showcase my work and skills.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <section id="contact" class="section">
        <div class="container">
            <h2 class="section-title">Contact</h2>
            <p>
                You can reach me at <strong>sameeracharaxxxx@gmail.com</strong>.  
                I’m open to new ideas, collaborations, and opportunities to learn and grow.
            </p>
            <a href="sameeracharaxxxxx@gmail.com" class="cta-button">Send Email</a>
        </div>
    </section>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2025 Sameer. All Rights Reserved.</p>
        </div>
    </footer>
    

<script>
  const text = "Engineering Student | Web Dev Enthusiast";
  const speed = 80;
  let i = 0;

  function typeWriter() {
    if (i < text.length) {
      document.getElementById("typewriter").innerHTML += text.charAt(i);
      i++;
      setTimeout(typeWriter, speed);
    }
  }

  window.onload = typeWriter;
</script>


</body>
</html>
